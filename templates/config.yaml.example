# Project harness config (optional). Copy to .specs/config.yaml and edit.
# Injected into phase procedures as project context.

schema: spec-driven

context: |
  Tech stack: (fill in)
  Test command: npm test
  Branch prefix: feat

rules:
  specify:
    - Prefer EARS acceptance criteria
    - Mark unknowns with [NEEDS CLARIFICATION: question]
  tasks:
    - Every REQ must appear in the Test Coverage Matrix
  verify:
    - Evidence must cite test file:line paths
